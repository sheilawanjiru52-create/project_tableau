      <aliases enabled='yes' />
      <column caption='County Rank' datatype='integer' name='[Calculation_0470344203780098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([overweight_obese]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='County Filter' datatype='boolean' name='[Calculation_0470344215998476]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 0470344215650315]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sort Value' datatype='real' name='[Calculation_0470344216776719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0470344216379406] = &quot;Highest&quot; THEN&#13;&#10;    SUM([overweight_obese])&#13;&#10;ELSE&#13;&#10;    -SUM([overweight_obese])&#13;&#10;END' />
      </column>
      <column caption='County Rank beans' datatype='integer' name='[Calculation_0470344251674640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([overweight_obese]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Obesity Group' datatype='string' name='[Calculation_0470344252141585]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0470344203780098] &lt;= 10 THEN&#13;&#10;    &quot;High Obesity&quot;&#13;&#10;ELSEIF [Calculation_0470344203780098] &gt; 36 THEN&#13;&#10;    &quot;Low Obesity&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Middle&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Obesity Category' datatype='string' name='[Calculation_0470344264531987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [overweight_obese] &gt;= 50 THEN &quot;High Obesity&quot;&#13;&#10;&#13;&#10;ELSEIF [overweight_obese] &gt;= 25 THEN &quot;Middle&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Obesity&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected food' datatype='real' name='[Calculation_0470344284999701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0470344283521044]&#13;&#10;&#13;&#10;WHEN &quot;Root &amp; Tubers&quot; THEN [White roots/tubers]&#13;&#10;&#13;&#10;WHEN &quot;Meat&quot; THEN [Meat/Fish/Poultry]&#13;&#10;&#13;&#10;WHEN &quot;Eggs&quot; THEN [Eggs]&#13;&#10;&#13;&#10;WHEN &quot;Nuts &amp; Seeds&quot; THEN [Nuts &amp; seeds]&#13;&#10;&#13;&#10;WHEN &quot;Leafy Vegetables&quot; THEN [Dark green vegetables]&#13;&#10;&#13;&#10;WHEN &quot;Vitamin A Fruits&quot; THEN [Vitamin A fruits &amp; vegetables]&#13;&#10;&#13;&#10;WHEN &quot;Grains&quot; THEN [Foods from grains]&#13;&#10;&#13;&#10;WHEN &quot;Beans/Peas/Lentils&quot; THEN [Beans/peas/lentils]&#13;&#10;&#13;&#10;WHEN &quot;Other Vegetables&quot; THEN [Other vegetables]&#13;&#10;&#13;&#10;WHEN &quot;Other Fruits&quot; THEN [Other fruits]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Selected Unhealthy Food' datatype='real' name='[Calculation_0470344301813786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0470344300961816]&#13;&#10;&#13;&#10;WHEN &quot;Sweet Foods&quot; THEN [Sweet foods]&#13;&#10;&#13;&#10;WHEN &quot;Fried Foods&quot; THEN [Fried &amp; salty foods]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='KPI 1: Highest Obesity County' datatype='string' name='[Calculation_0470344309092380]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([overweight_obese]),&apos;desc&apos;) = 1&#13;&#10;THEN ATTR([County])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Indicator' datatype='real' name='[Calculation_0909049211154434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0909049209905153]&#13;&#10;&#13;&#10;WHEN &quot;Overweight &amp; Obesity&quot; THEN [overweight_obese]&#13;&#10;&#13;&#10;WHEN &quot;Minimum Dietary Diversity&quot; THEN [minimum_dietary_diversity]&#13;&#10;&#13;&#10;WHEN &quot;Unhealthy Food Consumption&quot; THEN [unhealthy_food_consumption]&#13;&#10;&#13;&#10;END' />
      </column>
