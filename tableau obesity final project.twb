            <column caption='Obesity Category' datatype='string' name='[Calculation_0470344264531987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [overweight_obese] &gt;= 50 THEN &quot;High Obesity&quot;&#13;&#10;&#13;&#10;ELSEIF [overweight_obese] &gt;= 25 THEN &quot;Middle&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Obesity&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Selected food' datatype='real' name='[Calculation_0470344284999701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0470344283521044]&#13;&#10;&#13;&#10;WHEN &quot;Root &amp; Tubers&quot; THEN [White roots/tubers]&#13;&#10;&#13;&#10;WHEN &quot;Meat&quot; THEN [Meat/Fish/Poultry]&#13;&#10;&#13;&#10;WHEN &quot;Eggs&quot; THEN [Eggs]&#13;&#10;&#13;&#10;WHEN &quot;Nuts &amp; Seeds&quot; THEN [Nuts &amp; seeds]&#13;&#10;&#13;&#10;WHEN &quot;Leafy Vegetables&quot; THEN [Dark green vegetables]&#13;&#10;&#13;&#10;WHEN &quot;Vitamin A Fruits&quot; THEN [Vitamin A fruits &amp; vegetables]&#13;&#10;&#13;&#10;WHEN &quot;Grains&quot; THEN [Foods from grains]&#13;&#10;&#13;&#10;WHEN &quot;Beans/Peas/Lentils&quot; THEN [Beans/peas/lentils]&#13;&#10;&#13;&#10;WHEN &quot;Other Vegetables&quot; THEN [Other vegetables]&#13;&#10;&#13;&#10;WHEN &quot;Other Fruits&quot; THEN [Other fruits]&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[County]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column datatype='real' name='[Dark green vegetables]' role='measure' type='quantitative' />
            <column datatype='real' name='[Eggs]' role='measure' type='quantitative' />
            <column datatype='real' name='[Foods from grains]' role='measure' type='quantitative' />
            <column datatype='real' name='[Meat/Fish/Poultry]' role='measure' type='quantitative' />
            <column datatype='real' name='[Nuts &amp; seeds]' role='measure' type='quantitative' />
            <column datatype='real' name='[Other fruits]' role='measure' type='quantitative' />
            <column datatype='real' name='[Other vegetables]' role='measure' type='quantitative' />
            <column datatype='real' name='[Vitamin A fruits &amp; vegetables]' role='measure' type='quantitative' />
            <column datatype='real' name='[White roots/tubers]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0470344264531987]' derivation='None' name='[none:Calculation_0470344264531987:nk]' pivot='key' type='nominal' />
            <column-instance column='[County]' derivation='None' name='[none:County:nk]' pivot='key' type='nominal' />
            <column caption='Overweight and Obese' datatype='real' name='[overweight_obese]' role='measure' type='quantitative' />
