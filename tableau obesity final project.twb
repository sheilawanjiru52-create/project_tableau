      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <layout-options>
            <title>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Calibri,sans-serif' fontsize='22'>Prevalence of Overweight and Obesity among Women across Kenyan Counties</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='950' minheight='950' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='42' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='97916' id='41' param='vert' type-v2='layout-flow' w='98802' x='599' y='1042'>
                <zone h='5730' id='19' type-v2='title' w='98802' x='599' y='1042'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
