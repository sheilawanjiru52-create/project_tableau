    <worksheet name='Eggs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'><![CDATA[<Sheet Name> consumption vs Obesity]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='county_master_sql' name='federated.0pt7b3d0bfgld61alyve90ha9675' />
          </datasources>
          <datasource-dependencies datasource='federated.0pt7b3d0bfgld61alyve90ha9675'>
            <column caption='Obesity Category' datatype='string' name='[Calculation_0470344264531987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [overweight_obese] &gt;= 50 THEN &quot;High Obesity&quot;&#13;&#10;&#13;&#10;ELSEIF [overweight_obese] &gt;= 25 THEN &quot;Middle&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Obesity&quot;&#13;&#10;&#13;&#10;END' />
