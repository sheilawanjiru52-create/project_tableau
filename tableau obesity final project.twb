            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Number of Counties' datatype='integer' name='[Parameter 0470344215650315]' param-domain-type='range' role='measure' type='quantitative' value='19'>
              <calculation class='tableau' formula='19' />
              <range granularity='1' max='46' min='1' />
            </column>
            <column caption='Ranking Type' datatype='string' name='[Parameter 0470344216379406]' param-domain-type='list' role='measure' type='nominal' value='&quot;Highest&quot;'>
              <calculation class='tableau' formula='&quot;Highest&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0pt7b3d0bfgld61alyve90ha9675'>
            <column caption='County Filter' datatype='boolean' name='[Calculation_0470344215998476]' role='measure' type='nominal'>
              <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 0470344215650315]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sort Value' datatype='real' name='[Calculation_0470344216776719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 0470344216379406] = &quot;Highest&quot; THEN&#13;&#10;    SUM([overweight_obese])&#13;&#10;ELSE&#13;&#10;    -SUM([overweight_obese])&#13;&#10;END' />
            </column>
            <column datatype='string' name='[County]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column-instance column='[County]' derivation='None' name='[none:County:nk]' pivot='key' type='nominal' />
            <column caption='Overweight and Obese' datatype='real' name='[overweight_obese]' role='measure' type='quantitative' />
            <column-instance column='[overweight_obese]' derivation='Sum' name='[sum:overweight_obese:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0470344215998476]' derivation='User' name='[usr:Calculation_0470344215998476:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_0470344216776719]' derivation='User' name='[usr:Calculation_0470344216776719:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0pt7b3d0bfgld61alyve90ha9675].[none:County:nk]' direction='DESC' using='[federated.0pt7b3d0bfgld61alyve90ha9675].[usr:Calculation_0470344216776719:qk]' />
          <filter class='categorical' column='[federated.0pt7b3d0bfgld61alyve90ha9675].[usr:Calculation_0470344215998476:nk:1]'>
            <groupfilter function='member' level='[usr:Calculation_0470344215998476:nk:1]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
