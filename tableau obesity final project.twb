    <dashboard enable-sort-zone-taborder='true' name='Dashboard 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Calibri,sans-serif' fontsize='22'>Consumption of Unhealthy Food Groups between Counties</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size sizing-mode='automatic' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='county_master_sql' name='federated.0pt7b3d0bfgld61alyve90ha9675' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Unhealthy food Group' datatype='string' name='[Parameter 0470344300961816]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sweet Foods&quot;'>
          <calculation class='tableau' formula='&quot;Sweet Foods&quot;' />
          <members>
            <member value='&quot;Sweet Foods&quot;' />
            <member value='&quot;Fried Foods&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0pt7b3d0bfgld61alyve90ha9675'>
        <column caption='Obesity Category' datatype='string' name='[Calculation_0470344264531987]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [overweight_obese] &gt;= 50 THEN &quot;High Obesity&quot;&#13;&#10;&#13;&#10;ELSEIF [overweight_obese] &gt;= 25 THEN &quot;Middle&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Obesity&quot;&#13;&#10;&#13;&#10;END' />
        </column>
        <column-instance column='[Calculation_0470344264531987]' derivation='None' name='[none:Calculation_0470344264531987:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97260' id='14' param='vert' type-v2='layout-flow' w='98614' x='693' y='1370'>
            <zone h='7534' id='15' type-v2='title' w='98614' x='693' y='1370'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='89726' id='7' param='horz' type-v2='layout-flow' w='98614' x='693' y='8904'>
              <zone h='89726' id='5' type-v2='layout-basic' w='84761' x='693' y='8904'>
                <zone h='89726' id='3' name='Interactive Unhealthy Food Analysis ' w='42381' x='693' y='8904'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='89726' id='20' type-v2='text' w='42380' x='43074' y='8904'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>KEY INSIGHTS</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Sweet Foods</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties consume the most sweet foods, ranging from </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>about 21–36%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, compared with </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>1–18%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in low-obesity counties. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Counties such as </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyandarua (36%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kiambu (35%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (33%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, and </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kirinyaga (33%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> record both high sweet food consumption and high obesity. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>This suggests a </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>positive association</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> between frequent sweet food consumption and obesity prevalence.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Fried Foods</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Fried food consumption is highest among </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>middle-obesity counties</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, with several counties consuming </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>30–41%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, while most high-obesity counties range between </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>15–32%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties such as </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kiambu (~32%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kirinyaga (~29%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, and </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (~22%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> still report relatively high fried food intake. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The findings indicate that fried foods may contribute to obesity, but the relationship is </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>less consistent</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> than for sweet foods. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Overall Conclusion</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Sweet food consumption shows the strongest positive relationship with obesity</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, with the highest-obesity counties consistently recording the greatest intake. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Fried food consumption is widespread across all obesity categories</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, suggesting that obesity is influenced by </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>overall dietary patterns rather than a single unhealthy food group</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone fixed-size='160' h='89726' id='6' is-fixed='true' param='vert' type-v2='layout-flow' w='13853' x='85454' y='8904'>
                <zone h='18493' id='8' name='Interactive Unhealthy Food Analysis ' param='[federated.0pt7b3d0bfgld61alyve90ha9675].[none:Calculation_0470344264531987:nk]' type-v2='filter' w='13853' x='85454' y='8904'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='14726' id='9' name='Interactive Unhealthy Food Analysis ' pane-specification-id='0' param='[federated.0pt7b3d0bfgld61alyve90ha9675].[none:Calculation_0470344264531987:nk]' type-v2='color' w='13853' x='85454' y='27397'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='8904' id='10' mode='compact' param='[Parameters].[Parameter 0470344300961816]' type-v2='paramctrl' w='13853' x='85454' y='42123'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <layout-options>
            <title>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Calibri,sans-serif' fontsize='22'>Consumption of Unhealthy Food Groups between Counties</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='38' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='37' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='7534' id='15' type-v2='title' w='98614' x='693' y='1370'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='18493' id='8' mode='checkdropdown' name='Interactive Unhealthy Food Analysis ' param='[federated.0pt7b3d0bfgld61alyve90ha9675].[none:Calculation_0470344264531987:nk]' type-v2='filter' w='13853' x='85454' y='8904'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='89726' id='3' is-fixed='true' name='Interactive Unhealthy Food Analysis ' w='42381' x='693' y='8904'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='14726' id='9' name='Interactive Unhealthy Food Analysis ' pane-specification-id='0' param='[federated.0pt7b3d0bfgld61alyve90ha9675].[none:Calculation_0470344264531987:nk]' type-v2='color' w='13853' x='85454' y='27397'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='89726' id='20' type-v2='text' w='42380' x='43074' y='8904'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>KEY INSIGHTS</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Sweet Foods</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties consume the most sweet foods, ranging from </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>about 21–36%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, compared with </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>1–18%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in low-obesity counties. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Counties such as </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyandarua (36%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kiambu (35%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (33%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, and </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kirinyaga (33%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> record both high sweet food consumption and high obesity. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>This suggests a </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>positive association</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> between frequent sweet food consumption and obesity prevalence.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Fried Foods</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Fried food consumption is highest among </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>middle-obesity counties</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, with several counties consuming </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>30–41%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, while most high-obesity counties range between </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>15–32%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties such as </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kiambu (~32%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kirinyaga (~29%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, and </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (~22%)</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> still report relatively high fried food intake. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The findings indicate that fried foods may contribute to obesity, but the relationship is </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>less consistent</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> than for sweet foods. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Overall Conclusion</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Sweet food consumption shows the strongest positive relationship with obesity</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, with the highest-obesity counties consistently recording the greatest intake. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Fried food consumption is widespread across all obesity categories</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, suggesting that obesity is influenced by </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>overall dietary patterns rather than a single unhealthy food group</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='8904' id='10' mode='compact' param='[Parameters].[Parameter 0470344300961816]' type-v2='paramctrl' w='13853' x='85454' y='42123'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{D1AC825A-DC44-419C-8F05-B16DB111F628}' />
    </dashboard>
    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='22'>Analysis of Dietary Consumption </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='22'>Patterns and Overweight &amp; Obesity Among </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='22'>Women Across Kenyan Counties</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='35' />
        </style-rule>
      </style>
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97916' id='1' param='vert' removable='false' type-v2='layout-flow' w='98828' x='586' y='1042'>
            <zone h='13672' id='3' type-v2='title' w='98828' x='586' y='1042' />
            <zone fixed-size='79' h='10286' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98828' x='586' y='14714' />
            <zone h='73958' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98828' x='586' y='25000'>
              <flipboard active-id='7' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Intro' captured-sheet='' id='2' />
                  <story-point caption='Aim' captured-sheet='' id='3' />
                  <story-point caption='Dashboard 1' captured-sheet='Dashboard 1' id='4'>
                    <capturedDeltas>
                      <dashboard name='Dashboard 1'>
                        <zone id='20'>
                          <formatted-text>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Key Insights</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='14'>1. There is a large disparity in obesity prevalence across counties.</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>The prevalence of overweight and obesity among women ranges from </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>10.2% in Turkana</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> to </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>64.6% in Kirinyaga</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, representing a difference of over </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>54 percentage points</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. This suggests that obesity is not evenly distributed across Kenya and varies considerably by county.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='14'>2. Central Kenyan counties record the highest prevalence.</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Counties such as </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Kirinyaga, Nyeri, Murang&apos;a, Kiambu, and Embu</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> consistently appear among the highest-ranking counties, with obesity prevalence exceeding </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>50%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
                            <run>Æ&#10;&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='14'>3. Northern counties record the lowest prevalence.</run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Turkana, Marsabit, Samburu, West Pokot, and Tana River</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> are among the counties with the lowest obesity prevalence, with rates generally below </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>25%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                      <datasource name='Parameters'>
                        <column name='[Parameter 0470344215650315]' value='10' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point captured-sheet='' id='11' />
                  <story-point caption='Dashboard 2' captured-sheet='Dashboard 2' id='5'>
                    <capturedDeltas>
                      <dashboard name='Dashboard 2'>
                        <zone id='20'>
                          <formatted-text>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Starchy Roots &amp; Tubers</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties consume </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>50–68%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, compared to </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>15–42%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in low-obesity counties. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyandarua (68%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (56%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> and </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kirinyaga (48%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> record high consumption. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Overlap with middle-obesity counties suggests a </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>moderate association</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Meat</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Ranges from </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>15–55%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in high-obesity counties and </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>16–30%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in low-obesity counties. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Middle-obesity counties such as </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Homa Bay (67%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> and </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Migori (62%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> consume even more. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Not a strong predictor</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> of obesity. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Eggs</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties consume </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>17–27%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, compared to </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>3–14%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in low-obesity counties. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (27%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kiambu (26%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> and </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kirinyaga (25%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> have the highest intake. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Overlap suggests </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>other factors also influence obesity</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Nuts &amp; Seeds</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Consumption is generally low (</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>0–8%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>) across most counties. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The highest intake is </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Vihiga (16%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, a middle-obesity county. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>No clear association</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> with obesity is observed. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Leafy Vegetables</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Consumption is consistently high (</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>40–86%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>) across all counties. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties consume levels similar to middle-obesity counties (</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>58–70%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>). </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High vegetable intake </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>does not correspond to lower obesity</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Vitamin A Fruits</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>High-obesity counties consume </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>42–60%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, compared with </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>8–30%</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> in low-obesity counties. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Embu (60%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kiambu (56%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> and </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Nyeri (53%)</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> record the highest intake. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Healthy foods appear to </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>coexist with unhealthy dietary habits</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#f28e2b' fontname='Benton Sans Book' fontsize='10'>Conclusion</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Healthy food intake </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>does not consistently correspond to lower obesity</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Many high-obesity counties consume </run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>both healthy and unhealthy foods</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>. </run>
                            <run>Æ&#10;</run>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Overall dietary patterns</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>, rather than healthy food intake alone, better explain obesity differences across Kenyan counties.</run>
                            <run>Æ&#10;</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                      <datasource name='Parameters'>
                        <column name='[Parameter 0470344283521044]' value='&quot;Vitamin A Fruits&quot;' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Dashboard 3' captured-sheet='Dashboard 3' id='6' />
                  <story-point caption='Summary' captured-sheet='' id='7' />
                  <story-point caption='Reccomendations' captured-sheet='' id='8' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='77604' hidden='true' id='6' story-point-id='2' type-v2='text' w='78843' x='3953' y='23438'>
          <formatted-text>
            <run bold='true' fontsize='15'>Introduction</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'> Background</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>Obesity has become an increasing public health concern in Kenya, with </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>45% of women aged 20–49 </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>being</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> overweight or obese</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>, compared to only </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>19% of men</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> within the same age group. </run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Google Sans,Arial,sans-serif' fontsize='12' lmargin='600' rmargin='600'>Obesity is clinically recognized as a </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans,Arial,sans-serif' fontsize='12' lmargin='600' rmargin='600'>complex, chronic multisystem disease</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> that directly triggers, accelerates, or worsens more than 200 medical conditions.</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>Excess body fat is directly, causally linked to at least </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Google Sans,Arial,sans-serif' fontsize='12' lmargin='600' rmargin='600'>13 different types of cancer;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> colon, pancreatic, esophageal, kidney, and uterine cancers.</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' lmargin='600' rmargin='600'>Why focus on diet?</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Most important </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>modifiable</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> determinants of Body Mass Index (BMI). </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>While obesity is influenced by multiple factors; physical activity, genetics, age, and socioeconomic conditions, dietary habits directly affect energy intake and nutritional quality. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Examining dietary consumption patterns across counties can therefore provide valuable insights into differences in overweight and obesity prevalence and help inform targeted nutrition interventions.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Problem Statement</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>While national surveys provide data on obesity prevalence and dietary consumption, these datasets are often analysed separately, making it difficult to identify county-level dietary patterns associated with obesity. </run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>This limits the ability of policymakers and public health practitioners to develop targeted, evidence-based nutrition interventions for counties with the greatest burden of overweight and obesity.</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Problem Solved</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>Integrates county-level obesity and dietary consumption data</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> to </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>explore the relationship</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> between </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>dietary patterns</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'> and </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>overweight and obesity among women in Kenya. </run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>The analysis provides data-driven insights that can support county-specific nutrition planning, public health interventions, and informed decision-making.</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='77083' hidden='true' id='7' story-point-id='3' type-v2='text' w='94802' x='1245' y='23177'>
          <formatted-text>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>Aim of the analysis</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11' lmargin='600' rmargin='600'>Explore the relationship between dietary consumption patterns and overweight and obesity among women across Kenyan counties. By comparing healthy and unhealthy food consumption in counties with high and low obesity prevalence, this project seeks to identify dietary patterns that may be associated with obesity.</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>Objectives </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='11'>1.     </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>To analyse the prevalence of overweight and obesity among women across Kenyan counties. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>2.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Æ      </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>To compare healthy food consumption between counties with high and low obesity prevalence. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>3.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Æ      </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>To compare unhealthy food consumption between counties with high and low obesity prevalence. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>4.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Æ      </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>To identify dietary patterns associated with high and low obesity prevalence among women across Kenyan counties. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>Specific Research Questions</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>1. How does the prevalence of overweight and obesity vary among women across Kenyan counties? </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>2. How does the consumption of healthy food groups differ between counties with high and low obesity prevalence? </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>3. How does the consumption of unhealthy food groups differ between counties with high and low obesity prevalence?</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>4. Which dietary patterns are associated with high and low obesity prevalence among women across Kenyan counties? </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='13'>Methodology</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Source</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Kenya Demographic and Health Survey 2022</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run auto-url='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://www.knbs.or.ke/reports/kdhs-2022/&amp;quot;'>https://www.knbs.or.ke/reports/kdhs-2022/</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Microsoft Excel</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Imported and cleaned the datasets. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Checked for missing values and ensured consistent variable names and formats. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>SQL</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Combined the obesity and dietary datasets using county as the common key. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Generated a structured table to support visualization in Tableau. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Tableau</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Connected to the SQL master dataset. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Created interactive dashboards to analyse obesity prevalence across Kenyan counties. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Developed parameter-driven visualisations to answer the objectives</run>
            <run fontalignment='0'>Æ&#10;&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='73698' id='8' story-point-id='7' type-v2='text' w='97731' x='952' y='20313'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Summary of Findings</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Obesity prevalence varied widely across counties, ranging from </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>10.2% in Turkana</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> to </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>64.6% in Kirinyaga</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, a difference of more than </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>54 percentage points</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>High-obesity counties generally consumed </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>more healthy foods</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> than low-obesity counties. For example, </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>root and tuber consumption</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> ranged from </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>50–68%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> in high-obesity counties compared with </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>15–42%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> in low-obesity counties, while </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Vitamin A-rich fruit consumption</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> ranged from </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>42–60%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> compared with </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>8–30%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, respectively. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>However, healthy food consumption </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>did not consistently correspond to lower obesity prevalence</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. Counties with the highest obesity rates, including </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Kirinyaga (64.6%)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Nyeri (63.0%)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, and </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Nyandarua (55.8%)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, also reported relatively high consumption of leafy vegetables, eggs, and Vitamin A-rich fruits. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>A clearer pattern emerged for </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>unhealthy foods</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. High-obesity counties consumed approximately </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>21–36% sweet foods</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, compared with </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>1–18%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> in low-obesity counties. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Counties such as </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Nyandarua (36%)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Kiambu (~35%)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, and </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Nyeri (33%)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> recorded both high obesity prevalence and high sweet food consumption. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Fried food consumption was also relatively high in many high- and middle-obesity counties, with values reaching </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>30–41%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, although this relationship was less consistent than for sweet foods. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Overall Conclusion</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>The findings suggest that </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>no single food group explains obesity differences across Kenyan counties</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. Instead, counties with high obesity prevalence tend to consume </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>both healthy and unhealthy foods</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> at relatively high levels. The strongest dietary pattern observed is the </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>higher consumption of sweet foods in counties with high obesity prevalence</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, while healthy food consumption alone does not appear sufficient to offset the effects of energy-dense diets.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Overall, the analysis indicates that </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>obesity among women in Kenyan counties is more closely associated with overall dietary patterns particularly frequent consumption of unhealthy foods than with healthy food intake alone</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. These findings highlight the importance of promoting </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>balanced diets</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, alongside county-specific nutrition interventions, to address the growing burden of overweight and obesity.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='66797' hidden='true' id='9' story-point-id='8' type-v2='text' w='81332' x='878' y='24740'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Recommendations for Future Improvement</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>I</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>ncorporate a county map</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> to visualise the geographic distribution of obesity prevalence and identify regional patterns more effectively. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Include demographic factors</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> such as </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>wealth index, urban/rural residence, age, education, and occupation</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> to better understand the drivers of obesity across counties. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Examine lifestyle factors</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, including physical activity, sedentary behaviour, and access to healthcare, to provide a more comprehensive analysis. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Analyse trends over multiple years</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> to determine how obesity and dietary patterns have changed over time, rather than relying on a single cross-sectional dataset. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Expand the dietary analysis</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> by considering portion sizes, meal frequency, and total energy intake, not just the frequency of food group consumption. </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>Final Takeaway</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>While healthy food consumption was generally high in many counties, it did not consistently correspond to lower obesity levels. </run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>In contrast, counties with higher obesity prevalence tended to report greater consumption of sweet and fried foods. </run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>These findings suggest that </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>overall dietary patterns, together with demographic and socioeconomic factors, are likely to play a more important role in explaining obesity differences than healthy food intake alone</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>.</run>
            <run fontalignment='0' lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' lmargin='600' rmargin='600'>Thank you!</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='60938' hidden='true' id='10' story-point-id='11' type-v2='text' w='72108' x='3294' y='25000'>
          <formatted-text>
            <run fontalignment='0' fontsize='12'>Key</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Starchy roots &amp; Tubers: Irish potatoes, white sweet potatoes, green banana, nduma (arrowroot), yams, or cassava </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Nuts &amp; Seeds: Groundnuts, cashews, pumpkin seeds, simsim (sesame seeds), or peanut butter </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Meat: Liver, blood, kidney, lung, gizzard, heart, sausages, Smokies, hot dogs, salami, ham, goat, beef, minced beef, mutton, pork, wild game, chicken, fish, dagaa, canned tuna, or seafood </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Vegetables: Sukuma wiki, spinach, managu (nightshade), terere (amaranth), saget, kunde (cowpea leaves), khandira (Ethiopian kale), mrenda (jute mallow), pumpkin leaves, nderema (Malabar spinach), mitoo, broccoli, or mchunga </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Vitamin A fruits: Carrots, pumpkin, butternut, or sweet potatoes that are orange inside, ripe pawpaw, ripe mangoes, passionfruit, or matunda ya damu </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Sweet foods: Cakes, sweet biscuits, candies, choco lates, ice cream, or ice lollies </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Fried and salty foods: Crisps, chips, ngumu, mandaazi, samosa, bhajias, or indomie </run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{E254648E-9B77-4B7C-AE7B-8543D2C2B6E9}' />
    </dashboard>
