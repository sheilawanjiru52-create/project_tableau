  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Dashboard 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Calibri,sans-serif' fontsize='22'>Prevalence of Overweight and Obesity among Women across Kenyan Counties</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='768' maxwidth='1336' minheight='768' minwidth='1336' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Number of Counties' datatype='integer' name='[Parameter 0470344215650315]' param-domain-type='range' role='measure' type='quantitative' value='19'>
          <calculation class='tableau' formula='19' />
          <range granularity='1' max='46' min='1' />
        </column>
        <column caption='Ranking Type' datatype='string' name='[Parameter 0470344216379406]' param-domain-type='list' role='measure' type='nominal' value='&quot;Highest&quot;'>
          <calculation class='tableau' formula='&quot;Highest&quot;' />
          <members>
            <member value='&quot;Highest&quot;' />
            <member value='&quot;Lowest&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97916' id='18' param='vert' type-v2='layout-flow' w='98802' x='599' y='1042'>
            <zone h='5730' id='19' type-v2='title' w='98802' x='599' y='1042'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='92186' id='7' param='horz' type-v2='layout-flow' w='98802' x='599' y='6772'>
              <zone h='92186' id='5' type-v2='layout-basic' w='86826' x='599' y='6772'>
                <zone h='71224' id='3' name='Interactive County Ranking' w='43413' x='599' y='27734'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='20962' id='11' param='horz' type-v2='layout-flow' w='86826' x='599' y='6772'>
                  <zone fixed-size='237' h='20962' id='13' is-fixed='true' name='KPI: Highest County' w='18339' x='599' y='6772'>
                    <layout-cache type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='265' h='20962' id='14' is-fixed='true' name='KPI; Lowest County' w='20434' x='18938' y='6772'>
                    <layout-cache type-h='fixed' type-w='fixed' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone forceUpdate='true' h='71224' id='20' type-v2='text' w='43413' x='44012' y='27734'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Key Insights</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>1. There is a large disparity in obesity prevalence across counties.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>The prevalence of overweight and obesity among women ranges from </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>10.2% in Turkana</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'> to </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>64.6% in Kirinyaga</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>, representing a difference of over </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>54 percentage points</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>. This suggests that obesity is not evenly distributed across Kenya and varies considerably by county.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>2. Central Kenyan counties record the highest prevalence.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Counties such as </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Kirinyaga, Nyeri, Murang&apos;a, Kiambu, and Embu</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'> consistently appear among the highest-ranking counties, with obesity prevalence exceeding </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>50%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>3. Northern counties record the lowest prevalence.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>Turkana, Marsabit, Samburu, West Pokot, and Tana River</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'> are among the counties with the lowest obesity prevalence, with rates generally below </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>25%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone fixed-size='160' h='92186' id='6' is-fixed='true' param='vert' type-v2='layout-flow' w='11976' x='87425' y='6772'>
                <zone h='8464' id='8' name='Interactive County Ranking' pane-specification-id='0' param='[federated.0pt7b3d0bfgld61alyve90ha9675].[sum:overweight_obese:qk]' type-v2='color' w='11976' x='87425' y='6772'>
